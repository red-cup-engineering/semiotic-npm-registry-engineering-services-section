{
  "name": "@red-cup-engineering/npm-registry-audit-service",
  "version": "0.1.8",
  "description": "Runs the live-registry dependency audit: derives internal scopes from the Verdaccio config that is already the registry's own access-control authority, lists the live catalog, and gates on unresolved-dependency defects. Replaces the deleted root Makefile's registry-audit target, which hand-copied a scope list that drifted out of sync with config.yaml.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/semiotic-npm-registry-engineering-services-section.git",
    "directory": "services/npm-registry-audit-service"
  },
  "type": "module",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/run-npm-registry-audit.mjs"
  },
  "bin": {
    "run-npm-registry-audit": "scripts/run-npm-registry-audit.mjs"
  },
  "files": [
    "src",
    "scripts",
    "package.json",
    "README.md",
    "docs/API.md",
    "examples/quickstart.test.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:consumer": "node --test examples/quickstart.test.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/npm-registry-graph-services-section": "0.6.1"
  },
  "engines": {
    "node": ">=22"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
